# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
AUTH_OTP_HASH_SECRET=use_a_long_random_server_only_secret


# SMTP Email Configuration (Nodemailer)
# Gmail Example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-google-app-password (16-character App Password)
#
# Custom / Webmail Example:
#   SMTP_HOST=mail.yourdomain.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=info@yourdomain.com
#   SMTP_PASS=your_mailbox_password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MedLex System <noreply@medlexsolutions.com>"
SMTP_REPLY_TO="MedLex Support <info@medlexsolutions.com>"
CONTACT_RECIPIENT_EMAIL=om083418@gmail.com

# Application Origin (server-side absolute URLs, redirects, and links)
APP_ORIGIN=http://localhost:3000

# Paddle Billing (one-time payments only)
# Keep API keys and webhook secrets server-only. The client token is public and
# is intentionally prefixed with NEXT_PUBLIC_. Leave payments disabled until
# transaction creation and verified webhook fulfillment are deployed together.
PADDLE_PAYMENTS_ENABLED=false
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Reusable Paddle product for non-catalog private-session prices.
PADDLE_PRIVATE_SESSION_PRODUCT_ID=
PADDLE_COURSE_PRODUCT_ID=
# Private Session Google Calendar Integration (Server-only OAuth 2.0)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Private Session Outbox / Fulfillment Cron Secret
PRIVATE_SESSION_CRON_SECRET=
